rules_version = '2';
// Locolo chat security rules (WS6).
//
// ⚠️ IDENTITY-BINDING PREREQUISITE:
// These rules only prevent spoofing if request.auth.uid equals the user's
// Supabase user id. Today the app signs into Firebase ANONYMOUSLY, so
// request.auth.uid is a random Firebase uid unrelated to the Supabase id in
// `participants` / `senderId`, and these rules would block legitimate access.
//
// Before deploying, bind identity one of two ways:
//   (A) Preferred: migrate chat to Supabase Realtime + Postgres RLS (drop
//       Firestore for chat). Then these rules are moot.
//   (B) Keep Firestore: replace Auth.auth().signInAnonymously() with a Firebase
//       CUSTOM TOKEN minted by a trusted backend from the verified Supabase
//       session, so request.auth.uid == Supabase user id. Then deploy these.
//
// Messages are E2E encrypted (ciphertext only) regardless — these rules add the
// access-control layer on top.

service cloud.firestore {
  match /databases/{database}/documents {

    match /conversations/{cid} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(cid)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
      }
    }
  }
}
